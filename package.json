{
  "name": "archthea-library-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:concurrency": "node backend/tests/concurrency.js",
    "check": "npm test && npm run build",
    "bootstrap:admin": "node backend/scripts/bootstrap-admin.js",
    "db:bundle": "node scripts/bundle-database.js",
    "docs:api": "node scripts/generate-openapi.js",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "verify:connection": "node backend/scripts/verify-connection.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
