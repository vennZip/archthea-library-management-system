digraph ErrorClasses {graph [rankdir=TB,bgcolor="transparent",pad="0.25",nodesep="0.6",ranksep="0.8",splines=polyline,outputorder=edgesfirst];
node [shape=plain,fontname="Arial",fontcolor="#243d5b"];
edge [fontname="Arial",fontsize=12,color="#6c91b8",fontcolor="#486585",penwidth=1.3,arrowsize=0.8];
AppError [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#f9e5ee"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">APPLICATION ERROR</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>AppError</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ name: String<BR ALIGN="LEFT"/>+ status: Number<BR ALIGN="LEFT"/>+ code: String<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(message, options)<BR ALIGN="LEFT"/>+ get publicBody(): Object<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
AuthenticationError [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#f9e5ee"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">APPLICATION ERROR</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>AuthenticationError</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(message)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ForbiddenError [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#f9e5ee"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">APPLICATION ERROR</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>ForbiddenError</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(message)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ValidationError [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#f9e5ee"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">APPLICATION ERROR</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>ValidationError</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- issues: Array<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(issues)<BR ALIGN="LEFT"/>+ get publicBody(): Object {override}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ConfigurationError [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#f9e5ee"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">APPLICATION ERROR</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>ConfigurationError</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor()<BR ALIGN="LEFT"/>+ get publicBody(): Object {override}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
Error [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#bac9db" BGCOLOR="#f0f5fa" STYLE="ROUNDED"><TR><TD><FONT POINT-SIZE="10">JAVASCRIPT BUILT-IN</FONT><BR/><FONT POINT-SIZE="19"><B>Error</B></FONT></TD></TR></TABLE>>];
Error -> AppError [dir=back,arrowtail=empty,arrowhead=none,color="#8870a1",penwidth=1.8];
AppError -> AuthenticationError [dir=back,arrowtail=empty,arrowhead=none,color="#8870a1",penwidth=1.8];
AppError -> ForbiddenError [dir=back,arrowtail=empty,arrowhead=none,color="#8870a1",penwidth=1.8];
AppError -> ValidationError [dir=back,arrowtail=empty,arrowhead=none,color="#8870a1",penwidth=1.8];
AppError -> ConfigurationError [dir=back,arrowtail=empty,arrowhead=none,color="#8870a1",penwidth=1.8];
{rank=same;AuthenticationError;ForbiddenError;ValidationError;ConfigurationError;}}
