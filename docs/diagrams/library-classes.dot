digraph LibraryClasses {graph [rankdir=TB,bgcolor="transparent",pad="0.25",nodesep="0.6",ranksep="0.8",splines=polyline,outputorder=edgesfirst];
node [shape=plain,fontname="Arial",fontcolor="#243d5b"];
edge [fontname="Arial",fontsize=12,color="#6c91b8",fontcolor="#486585",penwidth=1.3,arrowsize=0.8];
DashboardService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#deedff"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">SERVICE</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>DashboardService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- repository: LibraryRepository<BR ALIGN="LEFT"/>- circulation: CirculationService<BR ALIGN="LEFT"/>- catalog: CatalogService<BR ALIGN="LEFT"/>- accounts: AccountService<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(repository, circulation, catalog, accounts)<BR ALIGN="LEFT"/>+ student(user): Promise<BR ALIGN="LEFT"/>+ admin(user): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
CatalogService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#deedff"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">SERVICE</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>CatalogService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- repository: LibraryRepository<BR ALIGN="LEFT"/>- storage: StorageService<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(repository, storage)<BR ALIGN="LEFT"/>+ list(user, query): Promise<BR ALIGN="LEFT"/>+ detail(user, id): Promise<BR ALIGN="LEFT"/>+ save(user, id, data): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
CirculationService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#deedff"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">SERVICE</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>CirculationService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- repository: LibraryRepository<BR ALIGN="LEFT"/>- storage: StorageService<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(repository, storage)<BR ALIGN="LEFT"/>+ borrow(user, data, key): Promise<BR ALIGN="LEFT"/>+ returnBook(user, id, data, key): Promise<BR ALIGN="LEFT"/>+ reserve(user, data, key): Promise<BR ALIGN="LEFT"/>+ cancel(user, id): Promise<BR ALIGN="LEFT"/>+ loans(query, studentId): Promise<BR ALIGN="LEFT"/>+ reservations(query, studentId, bookId): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
AccountService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#deedff"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">SERVICE</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>AccountService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- repository: LibraryRepository<BR ALIGN="LEFT"/>- redirectUrl: String<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(repository, redirectUrl)<BR ALIGN="LEFT"/>+ detail(id): Promise<BR ALIGN="LEFT"/>+ register(actor, data): Promise<BR ALIGN="LEFT"/>+ eligibility(id): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
StorageService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#deedff"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">SERVICE</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>StorageService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- repository: LibraryRepository<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(repository)<BR ALIGN="LEFT"/>+ get bucket(): Object<BR ALIGN="LEFT"/>+ decorate(books): Promise<BR ALIGN="LEFT"/>+ upload(actor, bookId, file): Promise<BR ALIGN="LEFT"/>+ remove(actor, bookId): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
BaseRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#e9e5fb"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">REPOSITORY</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>BaseRepository</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ execute(query): Promise<BR ALIGN="LEFT"/>+ rpc(): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
LibraryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#a9c5e4" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#e9e5fb"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#526985">REPOSITORY</FONT><BR/><FONT FACE="Arial" POINT-SIZE="20"><B>LibraryRepository</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">- client: SupabaseClient | null<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="14">+ constructor(client)<BR ALIGN="LEFT"/>+ get client(): SupabaseClient<BR ALIGN="LEFT"/>+ rpc(name, args): Promise {override}<BR ALIGN="LEFT"/>+ profile(id, scopedClient): Promise<BR ALIGN="LEFT"/>+ catalog(query, actorId): Promise<BR ALIGN="LEFT"/>+ book(id): Promise<BR ALIGN="LEFT"/>+ references(table, scopedClient): Promise<BR ALIGN="LEFT"/>+ copies(book, query): Promise<BR ALIGN="LEFT"/>+ loans(query, studentId): Promise<BR ALIGN="LEFT"/>+ loan(id): Promise<BR ALIGN="LEFT"/>+ reservations(query, studentId, bookId): Promise<BR ALIGN="LEFT"/>+ students(query): Promise<BR ALIGN="LEFT"/>+ student(id): Promise<BR ALIGN="LEFT"/>+ settings(scopedClient): Promise<BR ALIGN="LEFT"/>+ notifications(id, query, scopedClient): Promise<BR ALIGN="LEFT"/>+ audit(query, scopedClient): Promise<BR ALIGN="LEFT"/>+ count(table, filters): Promise<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
SupabaseClient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#bac9db" BGCOLOR="#f0f5fa" STYLE="ROUNDED"><TR><TD><FONT POINT-SIZE="10">EXTERNAL SDK</FONT><BR/><FONT POINT-SIZE="19"><B>SupabaseClient</B></FONT></TD></TR></TABLE>>];
